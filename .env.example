# AI Explorers — environment variables
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Never commit .env.local.

# --- Required by the web app -------------------------------------------------
# Your project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLIC key: "anon" (legacy) or "publishable" (sb_publishable_...).
# It is safe in the browser because row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------------
# Public address of this site, used in sign-up and password-reset emails.
# Defaults to http://localhost:3000 locally and to the Vercel URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# --- Trusted scripts only (never used by the web app, never NEXT_PUBLIC_) ------
# The SECRET key: "service_role" (legacy) or "secret" (sb_secret_...).
# It bypasses row-level security. Needed only for `npm run admin:grant` and the
# live end-to-end tests. Do not add it to Vercel unless a server job needs it.
SUPABASE_SERVICE_ROLE_KEY=
